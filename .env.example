# Variable names only. Copy to .env and fill in by hand. Never commit .env.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
ISBNDB_API_KEY=
# Optional: Google Books works without it for a few requests, but the full fetch needs it.
GOOGLE_BOOKS_API_KEY=
# Optional: AI alt text for bookish pictures. OPENAI_API_KEY is required for it.
OPENAI_API_KEY=
# Optional: only for an OpenAI-compatible service such as Google Gemini. Set both of these, or neither.
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=
# Optional: model used when the two lines above are not set (defaults to gpt-4o-mini).
OPENAI_MODEL=
